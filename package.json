{
  "name": "zcatalog",
  "description": "Catalog for Acumen Resources",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nitro build",
    "dev": "nitro dev",
    "preview": "nitro preview",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit --checkers 8",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "check": "pnpm fmt --check && pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:verbose": "vitest --watch=false --reporter=verbose",
    "release": "genbumppush --yes"
  },
  "dependencies": {
    "evlog": "^2.33.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@types/node": "26.6.5",
    "genbumppush": "0.0.10",
    "lefthook": "2.2.2",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  }
}
