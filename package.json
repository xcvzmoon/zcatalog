{
  "name": "zcatalog",
  "description": "Catalog for Acumen Resources",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nitro build",
    "dev": "nitro dev",
    "preview": "nitro preview",
    "typecheck": "tsrs --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "nitro": "3.0.260903-beta",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  }
}
